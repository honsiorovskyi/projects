#!/bin/bash
# vim:ft=bash
#
# Create a new project and optionally add repos

set -e

PROJECTS_HOME="${PROJECTS_HOME:-$HOME/projects}"

if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  cat <<EOF
Usage: pnew [--print] [name] [repo_filter]

Create a new project directory and optionally clone repos into it.

Options:
  --print   Print the path instead of spawning a new shell

Arguments:
  name          Project name (will be hyphenated)
  repo_filter   Initial search query for padd

If arguments are omitted, you will be prompted for them.
Project folder will be: \$PROJECTS_HOME/<name>

After creation, runs \$PROJECTS_POST_CREATE_CMD if set.

Environment:
  PROJECTS_HOME              Base projects directory (default: ~/projects)
  PROJECTS_POST_CREATE_CMD   Command to run after project creation (receives project path)
EOF
  exit 0
fi

print_only=false
if [[ "$1" == "--print" ]]; then
  print_only=true
  shift
fi

# Hyphenate a string: lowercase, non-alphanumeric to dashes
hyphenate() {
  echo "$1" | tr -c '[:alnum:]' '-' | tr '[:upper:]' '[:lower:]' | sed 's/-\+/-/g; s/^-//; s/-$//'
}

# Get arguments or prompt
name="${1:-}"
repo_filter="${2:-}"

if [[ -z "$name" ]]; then
  read -r -p "Project name: " name
fi

# Process inputs
name=$(hyphenate "$name")

if [[ -z "$name" ]]; then
  echo "Error: Project name is required" >&2
  exit 1
fi

project_name="$name"

project_path="$PROJECTS_HOME/$project_name"

# Check if folder exists
if [[ -d "$project_path" ]]; then
  echo "Error: Project folder already exists: $project_path" >&2
  exit 1
fi

# Create folder
mkdir -p "$project_path"
cd "$project_path"

# Call padd if repo_filter provided, otherwise just run padd
if [[ -n "$repo_filter" ]]; then
  padd "$repo_filter"
else
  padd
fi

# Run post-create hook if configured
if [[ -n "${PROJECTS_POST_CREATE_CMD:-}" ]]; then
  $PROJECTS_POST_CREATE_CMD "$project_path"
fi

# Spawn a new shell in the project directory
if [[ "$print_only" == true ]]; then
  echo "$project_path"
else
  exec $SHELL
fi
